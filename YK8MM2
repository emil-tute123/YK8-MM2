    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = row
    return row
end

local function createLabel(parent, text, size, position)
    local label = Instance.new("TextLabel")
    label.Size = size
    label.Position = position
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 235, 238)
    label.TextSize = 13
    label.Font = Enum.Font.PermanentMarker
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.Parent = parent
    return label
end

local function createButton(parent, text, size, position, callback)
    local button = Instance.new("TextButton")
    button.Size = size
    button.Position = position
    button.BackgroundColor3 = Color3.fromRGB(160, 30, 52)
    button.BorderSizePixel = 0
    button.Text = text
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 13
    button.Font = Enum.Font.PermanentMarker
    button.AutoButtonColor = true
    button.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = button
    button.MouseButton1Click:Connect(callback)
    return button
end

local function createToggle(page, labelText, callback)
    local row = createRow(page, labelText)
    createLabel(row, labelText, UDim2.new(0.64, -8, 1, 0), UDim2.new(0, 10, 0, 0))

    local enabled = false
    local button
    button = createButton(row, "OFF", UDim2.new(0.3, 0, 0, 28), UDim2.new(0.68, 0, 0.5, -14), function()
        enabled = not enabled
        button.Text = enabled and "ON" or "OFF"
        button.BackgroundColor3 = enabled and Color3.fromRGB(67, 150, 112) or Color3.fromRGB(160, 30, 52)
        callback(enabled)
    end)
    return button
end

local function createNumberRow(page, labelText, defaultValue, propertyName, minimum, maximum)
    local row = createRow(page, labelText, 48)
    createLabel(row, labelText, UDim2.new(0.34, -8, 1, 0), UDim2.new(0, 10, 0, 0))

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(0.24, 0, 0, 28)
    input.Position = UDim2.new(0.36, 0, 0.5, -14)
    input.BackgroundColor3 = Color3.fromRGB(28, 12, 20)
    input.BorderSizePixel = 0
    input.ClearTextOnFocus = false
    input.Text = tostring(defaultValue)
    input.PlaceholderText = "Value"
    input.TextColor3 = Color3.fromRGB(255, 255, 255)
    input.TextSize = 13
    input.Font = Enum.Font.Gotham
    input.Parent = row

    local inputCorner = Instance.new("UICorner")
    inputCorner.CornerRadius = UDim.new(0, 6)
    inputCorner.Parent = input

    createButton(row, "Set", UDim2.new(0.16, 0, 0, 28), UDim2.new(0.63, 0, 0.5, -14), function()
        local value = tonumber(input.Text)
        local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if value and humanoid then
            humanoid[propertyName] = math.clamp(value, minimum, maximum)
        end
    end)

    createButton(row, "Reset", UDim2.new(0.17, 0, 0, 28), UDim2.new(0.81, 0, 0.5, -14), function()
        local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid[propertyName] = defaultValue
            input.Text = tostring(defaultValue)
        end
    end)
end

