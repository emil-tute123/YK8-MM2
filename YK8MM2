local function showPage(selectedName)
    for pageName, page in pairs(pages) do
        page.Visible = pageName == selectedName
        tabs[pageName].BackgroundColor3 = pageName == selectedName
            and Color3.fromRGB(160, 30, 52)
            or Color3.fromRGB(48, 16, 26)
    end
end

for pageName, tab in pairs(tabs) do
    tab.MouseButton1Click:Connect(function()
        showPage(pageName)
    end)
end

local function createRow(page, rowName, rowHeight)
    local row = Instance.new("Frame")
    row.Name = rowName
